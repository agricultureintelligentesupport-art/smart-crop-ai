# ─────────────────────────────────────────────────────────────────────────────
# Firebase Auth configuration (all values are read from the runtime env and
# inlined into both the server and the browser bundle by Next.js).
#
# Copy to `.env.local` (git-ignored) for local development, and set the same
# variables in the hosting provider (Vercel → Project → Environment Variables).
#
# Every NEXT_PUBLIC_FIREBASE_* value below is optional at build time: when a
# variable is missing the app falls back to the documented fallback project and
# says so in the console + in the in-app diagnostics panel. In production, set
# them all (an incomplete set is the most common cause of
# `auth/invalid-api-key`, `auth/configuration-not-found` and redirect failures).
# ─────────────────────────────────────────────────────────────────────────────

# "firebase" → real Firebase Auth · "demo" → on-device gateway · "auto" → Firebase
# when the config below is complete, demo otherwise. Default when unset: demo.
NEXT_PUBLIC_AUTH_BACKEND=firebase

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAbb9aCsOfMkw9G5H0L58LSkbsONhix51k
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=agriculture-intelligente-7873e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=agriculture-intelligente-7873e
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=agriculture-intelligente-7873e.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=213483282746
NEXT_PUBLIC_FIREBASE_APP_ID=1:213483282746:web:badde539687095497a7003
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-VKD4SWJLNJ

# Firebase Console → Authentication → Settings → Authorized domains must list
# every origin the app is served from, including the Arena preview host
# (*.e2b.app) and http://localhost:3000 for local development.

# ─────────────────────────────────────────────────────────────────────────────
# AI assistant — hybrid pipeline behind /api/assistant (server-only secret;
# NO NEXT_PUBLIC_ prefix so it is never inlined into the browser bundle).
#
# HUGGINGFACE_API_KEY  → Hugging Face → Settings → Access Tokens (read scope)
#                        powers BOTH pipeline stages on the HF Inference API:
#                        Step 1 — PlantVillage leaf-disease vision classifier,
#                        Step 2 — LLM concise Arabic reasoning on a non-gated
#                        chain: Qwen/Qwen2.5-Coder-7B-Instruct →
#                        HuggingFaceH4/zephyr-7b-beta →
#                        TiagoPires/Xenova-Qwen1.5-0.5B-Chat. If every LLM is
#                        unavailable, a built-in formatter still answers from
#                        the Step 1 diagnosis (source: "direct", never a 500).
#
# Required on the server at runtime (including on Vercel).
# A missing/blank key returns HTTP 500 with code MISSING_KEYS only on request.
# Never expose this secret with a NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────────────────────
HUGGINGFACE_API_KEY=
